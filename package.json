{
  "name": "sec-edit",
  "version": "0.5.0",
  "description": "Fast, folder-based markdown & code editor",
  "main": "dist/main/main.cjs",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build && node scripts/build-node.mjs",
    "build:node": "node scripts/build-node.mjs",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "serve": "node dist/server/cli.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && vitest run && playwright test",
    "stage": "node scripts/stage.mjs",
    "package:win": "node scripts/package.mjs win32",
    "package:linux": "node scripts/package.mjs linux",
    "test:electron": "playwright test -c playwright.electron.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "analyze": "node scripts/analyze-bundle.mjs",
    "iteration": "node scripts/iteration.mjs",
    "security": "node scripts/security.mjs"
  },
  "keywords": [],
  "author": "Shiva Kerdel",
  "license": "GPL-3.0-or-later",
  "repository": "github:s-kerdel/One-Editor",
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@preact/signals": "^2.11.4",
    "@prettier/plugin-php": "^0.26.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^6.0.0",
    "dompurify": "^3.4.18",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.3.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.2.0",
    "prettier": "^3.10.1",
    "sh-syntax": "^0.8.7",
    "shiki": "^4.6.0",
    "sql-formatter": "^15.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.1",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "electron@45.3.4": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  },
  "bin": {
    "sec-edit": "bin/sec-edit.mjs"
  }
}
